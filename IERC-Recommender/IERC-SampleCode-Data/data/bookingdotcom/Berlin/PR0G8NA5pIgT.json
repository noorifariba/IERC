68.jpg?k=c4a7242e98bc8d160a299db725589ebb8b9b20afe5d40a5073af0343af9820db&o="}, {"hereProductPageMobile": "https://q-xx.bstatic.com/xdata/images/xphoto/800x800/144123701.jpg?k=238c056acc69432fbb3407a5c223960f04affdb08715bb40fa9f6dcbd35c2c74&o=", "hereProductPageDesktop": "https://r-xx.bstatic.com/xdata/images/xphoto/1200x400/144123701.jpg?k=238c056acc69432fbb3407a5c223960f04affdb08715bb40fa9f6dcbd35c2c74&o=", "__typename": "AttractionsPhoto", "gallery": "https://q-xx.bstatic.com/xdata/images/xphoto/max1200/144123701.jpg?k=238c056acc69432fbb3407a5c223960f04affdb08715bb40fa9f6dcbd35c2c74&o=", "small": "https://r-xx.bstatic.com/xdata/images/xphoto/300x320/144123701.jpg?k=238c056acc69432fbb3407a5c223960f04affdb08715bb40fa9f6dcbd35c2c74&o="}, {"hereProductPageMobile": "https://r-xx.bstatic.com/xdata/images/xphoto/800x800/144123737.jpg?k=0a3a0695697a0755349c903bd3652d70c7c6fd73a3a964f63639c4c6a781ecfa&o=", "hereProductPageDesktop": "https://q-xx.bstatic.com/xdata/images/xphoto/1200x400/144123737.jpg?k=0a3a0695697a0755349c903bd3652d70c7c6fd73a3a964f63639c4c6a781ecfa&o=", "small": "https://q-xx.bstatic.com/xdata/images/xphoto/300x320/144123737.jpg?k=0a3a0695697a0755349c903bd3652d70c7c6fd73a3a964f63639c4c6a781ecfa&o=", "__typename": "AttractionsPhoto", "gallery": "https://q-xx.bstatic.com/xdata/images/xphoto/max1200/144123737.jpg?k=0a3a0695697a0755349c903bd3652d70c7c6fd73a3a964f63639c4c6a781ecfa&o="}], "restrictions": [], "pickupTypes": [{"type": "point_pickup", "__typename": "ProductPickup"}], "representativePrice": {"chargeAmount": 157.24, "__typename": "AttractionsPrice", "currency": "GBP", "publicAmount": 157.24}, "description": "With this tour, you\u2019ll learn all about the history of Potsdam during the Soviet era. You\u2019ll also discover the history of the former Prussian residential city, the Potsdam Allied Conference of 1945, the Cold War, the Berlin Wall and the infamous Bridge of Spies. Your private tour will begin at the main train station and head through the Alter Markt, the historical centre of the city. From there you\u2019ll take a walk to the Soviet Cemetery of Honor at Bassinplatz and then a bus to Cecilienhof Palace and the Neuer Garten, where the Potsdam Conference was held. Your tour will come to a close with a visit to the military town No. 7 and the infamous Bridge of Spies, where agents were exchanged during the Cold War.", "guideSupportedLanguages": ["German"], "supplierInfo": [{"isIndividual": false, "__typename": "AttractionsSupplierInfo", "details": {"__typename": "AttractionsSupplierInfoDetails", "name": "Musement S.p.A", "address": "via Polesine 13, 20139 Milan, Italy"}}], "contextUfiDetails": null, "timeZone": "Europe/Berlin", "postBookingInfo": null, "additionalInfo": "The tour takes place in all weather conditions, so please dress accordingly.\r\n\r\nThe ticket for the bus, the Potsdam AB, is not included in the price.\r\n\r\nPlease bring your ticket with you to the attraction.\r\n\r\nBe aware that operators may cancel for unforeseen reasons.\r\n\r\nYou need to be 18 years or older to book or be accompanied by an adult. ", "applicableTerms": [{"policyProvider": "Booking.com", "__typename": "TermsConditions"}, {"__typename": "TermsConditions", "policyProvider": "Musement"}], "url": "https://www.booking.com/attractions/en/pr0g8na5pigt-soviet-potsdam-tour.html", "ReviewDetails": []}